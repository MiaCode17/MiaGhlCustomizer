NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/customizer?retryWrites=true&w=majority
# Admin frontend address(es) allowed to log in, comma-separated. Defaults to local dev + the deployed admin site.
CORS_ORIGIN=http://localhost:5173,https://miaghlcustomizer-1.onrender.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<random-32+-char-secret>
# Optional separate key for encrypting stored credentials (the GHL API token). Falls back to JWT_SECRET.
# Changing it makes already-saved tokens unreadable; they would need to be re-entered.
# SECRETS_KEY=<random-32+-char-secret>
# Used once, on first boot, to create the initial admin user. Optional after that.
ADMIN_EMAIL=<your-email>
ADMIN_PASSWORD=<a-strong-password>
# Public origin of this API as reached from inside GHL (baked into the embed script).
# Optional: defaults to the host the script was requested from.
# PUBLIC_BASE_URL=https://customizer-api.example.com

# GHL Marketplace app credentials (Marketplace → your app → Advanced Settings → Client keys).
# Keep the secret out of git; set the same values in Render → Environment.
GHL_APP_ID=<app-id>
GHL_CLIENT_ID=<client-id>
GHL_CLIENT_SECRET=<client-secret>
GHL_REDIRECT_URL=https://<your-backend-domain>/api/v1/oauth/callback
